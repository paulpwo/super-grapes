{
  "name": "@paulpwo/super-grapes",
  "version": "0.2.0",
  "description": "Visual page builder powered by GrapesJS",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/super-grapes.cjs",
  "module": "dist/super-grapes.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/super-grapes.mjs",
      "require": "./dist/super-grapes.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-LICENSES"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulpwo/super-grapes.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build:lib"
  },
  "peerDependencies": {
    "grapesjs": "^0.21.0"
  },
  "dependencies": {
    "grapesjs-component-countdown": "^1.0.2",
    "grapesjs-custom-code": "^1.0.2",
    "grapesjs-preset-webpage": "^1.0.3",
    "openai": "^6.27.0"
  },
  "devDependencies": {
    "grapesjs": "^0.21.13",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
